VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY is a SERVER-SIDE SECRET — do NOT prefix with VITE_.
# Set it via the Supabase CLI: supabase secrets set GEMINI_API_KEY=your-key
# It is used only inside the Supabase Edge Function (supabase/functions/chat/)
# and is never exposed to the browser.
